# Local Docker PostgreSQL
DATABASE_URL="postgresql://delivery:delivery@localhost:5432/menuqr?schema=public"
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
PORT=3001
UPLOAD_MAX_SIZE=5242880
# S3 (optional for local file upload)
AWS_REGION=eu-central-1
AWS_S3_BUCKET=menuqr-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Or use local storage
UPLOAD_DRIVER=local
UPLOAD_LOCAL_PATH=./uploads
# delivery-redis (redis:7-alpine) mapped to localhost:6379 — no TTL; catalog is invalidated on writes
REDIS_URL=redis://localhost:6379
