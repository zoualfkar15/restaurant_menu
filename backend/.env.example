# Aiven PostgreSQL Service URI (Overview → Connection information).
# Add sslmode=require if the URI does not already include it.
DATABASE_URL="postgres://AVNADMIN:PASSWORD@HOST:PORT/defaultdb?sslmode=require"
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
PORT=3001
# Public site origin (QR menu links). Local: Vite. Production: Cloudflare Pages.
FRONTEND_URL=http://localhost:3000
# Extra CORS origins (comma-separated). *.pages.dev and *.onrender.com are already allowed in code.
CORS_ORIGIN=http://localhost:3000
# Production Render example:
# FRONTEND_URL=https://menuqr-ekk.pages.dev
# CORS_ORIGIN=https://menuqr-ekk.pages.dev
# Set true so Vercel preview URLs (*.vercel.app) can call the API
CORS_ALLOW_VERCEL_PREVIEWS=false
UPLOAD_MAX_SIZE=5242880
# S3 (optional for local file upload)
AWS_REGION=eu-central-1
AWS_S3_BUCKET=menuqr-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Or use local storage
UPLOAD_DRIVER=local
UPLOAD_LOCAL_PATH=./uploads
# Cloudflare Pages KV purge (public catalog/menu/profile/product JSON).
# CACHE_PURGE_SECRET must match the Pages Function secret.
CACHE_PURGE_URL=https://menuqr-ekk.pages.dev/api/_cache/purge
CACHE_PURGE_SECRET=
